PORT=5000
NODE_ENV=development

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/neet_pg_platform

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Dataset path (absolute or relative from project root)
DATASET_PATH=./data/neet_pg_dataset

# 32-byte (64 hex char) key used to encrypt user-supplied Anthropic API keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_this_to_a_64_char_hex_string_before_deploying

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
