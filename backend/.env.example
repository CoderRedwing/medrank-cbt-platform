PORT=5000
NODE_ENV=development

# MongoDB Atlas URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/neet_pg_platform

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Dataset path (absolute or relative from project root)
DATASET_PATH=./data/neet_pg_dataset

# Anthropic API Key (Phase 3 — AI Tutor)
ANTHROPIC_API_KEY=sk-ant-...

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
