      "marks_incorrect": -1,
      "marks_unanswered": 0,
      "question_text": "Type II error (β error) is?",
      "options": {
        "A": "Rejecting true null hypothesis",
        "B": "Accepting false null hypothesis (missing a true effect)",
        "C": "Setting alpha too high",
        "D": "Increasing sample size"
      },
      "correct_answer": "B",
      "explanation": "Type II (β) error: failing to reject a false null hypothesis = missed effect (false negative). Power = 1-β. Increased by small sample size, low effect size, high variability."
    },
