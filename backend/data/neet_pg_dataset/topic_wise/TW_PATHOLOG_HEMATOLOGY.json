      "question_text": "Reed-Sternberg cells are pathognomonic of?",
      "options": {
        "A": "Non-Hodgkin lymphoma",
        "B": "Hodgkin's lymphoma",
        "C": "Multiple myeloma",
        "D": "CLL"
