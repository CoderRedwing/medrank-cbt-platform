      "question_text": "Infant mortality rate (IMR) formula?",
      "options": {
        "A": "Deaths <5 years / live births × 1000",
        "B": "Deaths <1 year / live births × 1000",
        "C": "Deaths <28 days / live births × 1000",
        "D": "Deaths <1 year / total population × 1000"
