      "question_text": "OCD: ego-dystonic or ego-syntonic?",
      "options": {
        "A": "Ego-syntonic (desired behavior)",
        "B": "Ego-dystonic (unwanted, distressing)",
        "C": "Neither",
        "D": "Depends on severity"
